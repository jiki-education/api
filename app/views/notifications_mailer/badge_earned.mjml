- content_for :title, @subject
- content_for :preview, preview_from(@content_markdown)

%mj-section{ "background-color": "#ffffff" }
  %mj-column
    %mj-text
      = t("notifications_mailer.badge_earned.greeting")

    - if @image_url.present?
      -# Decorative: the body copy below already names the badge.
      %mj-image{ src: @image_url, alt: "", width: "100%" }

    %mj-text
      = markdown_to_html(@content_markdown)
      %p
        = t("notifications_mailer.badge_earned.signoff")
        %br
        = t("notifications_mailer.badge_earned.team")
